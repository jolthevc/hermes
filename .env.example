# Copy to .env and fill in. .env is git-ignored. Never commit keys or paste them into chat.

# Postgres (Neon). Pooled URL for the app; direct (non-pooler) URL for migrations and the job queue.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Models (all via OpenRouter, Claude included)
OPENROUTER_API_KEY=

# Object storage (S3-compatible: Cloudflare R2 in production, MinIO locally via docker compose)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=hermes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# GPU workers. Backends are tried in order: the first is primary, later ones are fallbacks.
#   vast    = Vast.ai Serverless (cheapest; marketplace hosts)
#   runpod  = RunPod Serverless (reliable fallback)
#   salad   = SaladCloud (kept as an option; not recommended)
#   local   = mock workers via docker compose --profile mock (dev only)
GPU_BACKENDS=vast,runpod

# Vast.ai (console -> Account -> API Keys)
VAST_API_KEY=

# RunPod (console -> Settings -> API Keys; needs read/write for Serverless)
RUNPOD_API_KEY=

# SaladCloud (optional)
SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=

# Scraping (research only)
APIFY_TOKEN=

# Budgets (USD)
SPEND_CAP_USD_DAILY=20
SPEND_CAP_USD_PER_SKETCH=1
